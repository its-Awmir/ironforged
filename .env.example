DATABASE_URL="postgresql://user:password@localhost:5432/meridian_db"
NODE_ENV="development"
SESSION_SECRET="changeme-to-a-long-random-secret-in-production"
NEXT_PUBLIC_SITE_URL="https://meridian.example.com"
